---
import HomePage from '../../components/HomePage.astro';
import { nonDefaultBlogLangs, type Lang } from '../../i18n/translations';
export function getStaticPaths() {
  return nonDefaultBlogLangs.map(lang => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: Exclude<Lang, 'ja'> };
---
<HomePage lang={lang} />
