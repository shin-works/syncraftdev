---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { blogLangs, type Lang } from '../i18n/translations';
import { t, getBlogIndexPath, getBlogPostPath, getLocalizedPath } from '../i18n/utils';
import { storyCopy } from '../i18n/story';
interface Props { lang: Lang; preview?: boolean; }
const { lang, preview = false } = Astro.props;
const copy = storyCopy[lang];
const home = getLocalizedPath('/', lang);
const alternateUrls = Object.fromEntries(blogLangs.map(code => [code, getLocalizedPath('/', code)]));
const links = {
  ts: lang === 'ja' ? '/timesense/' : `/timesense/${lang === 'pt' ? 'pt-br' : lang}/`,
  sr: lang === 'ja' ? '/stealthradar/' : `/stealthradar/${lang === 'de' ? 'de' : 'en'}/`,
  ct: lang === 'ja' ? '/clocktimer/' : '/clocktimer/en/',
  sc: lang === 'ja' ? '/swingcat/' : '/swingcat/en/',
};
const images = { ts: lang === 'ja' ? '/TS_OGP.png' : '/TS_OGP_en.png',
  sr: lang === 'ja' ? '/SR_OGP.png' : '/SR_OGP_en.png',
  ct: lang === 'ja' ? '/clocktimer_OGP.png' : '/clocktimer_OGP_en.png',
  sc: lang === 'ja' ? '/swingcat_ogp_ja.png' : '/swingcat_ogp_en.png' };
const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,2);
const shortTitles: Record<string,string> = {
  'timesense-multilingual-support': 'TimeSenseが、いろんな国のことばを覚えました。',
  'what-is-timesense': '「知育時計 × 声かけタイマー」TimeSenseとは？',
};
---
<BaseLayout title="SynCraft — Crafting ideas in sync." description={t(lang, 'site.description')} lang={lang}
  canonicalUrl={home} alternateUrls={alternateUrls} currentPath={preview ? '/preview/' : home} preview={preview}>

      <section id="hero" class="hero" aria-labelledby="hero-title">
        <div class="hero-heading">
          <h1 id="hero-title">Crafting ideas<br /><span class="second-line">in sync<span class="period">.</span></span></h1>
          <p class="hero-copy">{copy.hero[0]}<br />{copy.hero[1]}</p>
        </div>

        <div class="town-stage" id="town-stage">
          <button type="button" class="town-playground" id="town-jump" aria-label={copy.jumpLabel}>
            <svg class="town" viewBox="0 0 1440 310" role="img" aria-labelledby="town-title town-desc">
              <title id="town-title">{lang === 'ja' ? '一本の線から生まれる街' : 'A town drawn in one continuous line'}</title>
              <desc id="town-desc">{lang === 'ja' ? '一本の線で街ができ、小さな住人が走ったり跳んだりします。街をタップするとジャンプします。' : 'A single line builds a town while little residents run and jump. Tap the town to make them jump.'}</desc>
