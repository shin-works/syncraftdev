              </defs>
              <g class="distant-world" fill="none" stroke="#000" stroke-width="1.1" opacity=".36">
                <path d="M55 139q9-9 18 0 8-9 17 0M601 66q8-8 16 0 9-8 18 0M1475 71q8-9 17 0 9-9 17 0"/>
                <path d="M370 79q-17 0-15-10t17-10q5-19 20-12 18-6 20 13 18-1 18 9t-20 10Z M1530 116q-15-1-13-11t16-9q4-17 20-11 15-5 19 12 17 0 17 10t-19 9Z"/>
