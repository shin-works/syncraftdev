      <g class="runner-body"><path class="back-arm" d="m-7-16-6 5" fill="none"/>
      <path d="M-8-18q-1-12 8-12 10 0 9 13T0-7q-8 0-8-11Z" fill="#f5dc61"/><path d="M0-29q-6-9 2-12m-1 6q9-9 12-2-6 5-12 2" fill="none"/>
      <path d="m2-22 0 2m5-2v2" stroke="#000" stroke-width="1.5"/>
