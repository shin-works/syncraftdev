                  <path d="m189 172 5-27 24 6m36 19 4-26 22-6m21 65 7-16 13 10"/>
                  <path d="M187 212q19-30 50-18t44-23q3-28 14-48" stroke-dasharray="5 9"/>
                  <path d="m287 116 15 12m-14 1 12-15" stroke-width="5"/>
                  <g transform="translate(129 263) scale(2.4)" stroke-width="1.8">
                    <path d="M-4-7-9 0h-3m16-7 5 7h4m-20-16-6-5"/>
                    <path fill="#fff" d="M-8-18q-1-12 8-12 10 0 9 13T0-7q-8 0-8-11Z"/>
                    <path fill="#fff" d="M-7-28 0-38 7-28Z"/>
                    <path stroke-width="1.5" d="m2-22 0 2m5-2v2"/>
                    <path d="m8-16 9-8"/>
                  </g>
                  <path d="M374 257v-67m-24 24 24-24 22 24m-38 9 16-17 16 16m-27 10 11-12 13 11M350 258v-38m-12 14 12-15 13 13"/>
                  <path d="m90 95 9-11m-14 25-14-2m33-31 3-12"/>
                </g>
              </svg>
            </div>
              </a>
            </div>
            <a class="work-caption" href={links.sr}><div><h3>Stealth Radar<span class="work-dot" aria-hidden="true">.</span></h3><p>{lang === 'ja' ? 'いつもの街を、未知のフィールドに。' : t(lang, 'product.sr.desc')}</p>{lang === 'ja' && <span class="work-kind">日常を冒険に変える、GPS探索アプリ</span>}</div><span class="drawn-arrow" aria-hidden="true">↗</span></a>
          </article>
          <article class="work work-clock">
            <div class="work-visual" id="work-visual-clock">
              <a class="work-image-link" href={links.ct} aria-label={lang === 'ja' ? 'ClockTimerのプロダクトページ' : 'ClockTimer product page'}>
                <img class="work-ogp" src={images.ct} alt="ClockTimer" width="1200" height="630" loading="lazy" decoding="async" />
