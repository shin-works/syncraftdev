              </g>
            </svg>
          </button>
        </div>
        <div class="hero-bottom">
          <a class="scroll-note" href="#works" aria-label={copy.works}><span class="scroll-stroke" aria-hidden="true"></span></a>
          <div class="motion-controls" hidden>
            <span class="jump-hint">{copy.jump}</span>
            <button id="replay" type="button"><span aria-hidden="true">↻</span> {copy.replay}</button>
            <button id="pause" type="button" aria-pressed="false" aria-label={copy.pause} data-pause={copy.pause} data-resume={copy.resume}><svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"/></svg><svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 4 10 6-10 6Z"/></svg></button>
          </div>
        </div>
      </section>

      <section class="works section-wrap" id="works" aria-labelledby="works-title">
        <span id="product" aria-hidden="true"></span>
        <div class="section-heading">
          <h2 id="works-title" class="outline-title">WORKS</h2>
          <p>{copy.works}</p>
        </div>
        <div class="works-grid">
          <article class="work work-time">
            <div class="work-visual" id="work-visual-time">
              <a class="work-image-link" href={links.ts} aria-label={lang === 'ja' ? 'TimeSenseのプロダクトページ' : 'TimeSense product page'}>
                <img class="work-ogp" src={images.ts} alt="TimeSense" width="1200" height="630" loading="lazy" decoding="async" />
                <div class="work-drawing">
              <svg viewBox="0 0 480 320" aria-hidden="true">
                <g class="drawing-ink">
                  <path d="M92 270q110-9 287 0"/>
                  <g class="illustration-clock"><path fill="#fff" d="M180 93q-14-2-14-15t13-16l21 9m95 22q13 1 17-12t-9-18l-21 6"/><path d="m180 247-13 21m127-23 14 22"/><path fill="#fff" d="M332 168c0 61-39 93-91 93s-93-40-91-95 39-91 91-91 91 36 91 93Z"/><circle cx="241" cy="168" r="73"/><path class="clock-wedge" d="M241 168V95a73 73 0 0 1 68 100Z"/><path d="M241 107v10m61 51h-10m-51 61v-10m-62-51h10m52 0-29-26m29 26 35-25"/><circle cx="241" cy="168" r="5" fill="#000"/></g>
                  <g transform="translate(117 267) rotate(-8) scale(2.4)" stroke-width="1.8">
                    <path d="M-4-7-9 0h-3m16-7 5 7h4m-20-16-6 5"/>
                    <path fill="#000" d="M-8-18q-1-12 8-12 10 0 9 13T0-7q-8 0-8-11Z"/>
                    <path fill="#000" d="M-10-26 0-32 10-26Z"/>
                    <path stroke="#fff" stroke-width="1.5" d="m2-22 0 2m5-2v2"/>
                    <path d="m8-16 9-9"/>
                  </g>
                  <path d="m348 109 14-9m-23-5 6-16m11 43 18-1"/>
                  <path d="m112 115 7-14 6 13 14 4-13 6-4 14-7-13-13-4Z"/>
                </g>
              </svg>
            </div>
              </a>
            </div>
            <a class="work-caption" href={links.ts}><div><h3>TimeSense<span class="work-dot" aria-hidden="true">.</span></h3><p>{lang === 'ja' ? '時間が見えると、自分で動ける。' : t(lang, 'product.ts.desc')}</p>{lang === 'ja' && <span class="work-kind">子どもの時間感覚を育てる、ビジュアルタイマー</span>}</div><span class="drawn-arrow" aria-hidden="true">↗</span></a>
          </article>
          <article class="work work-cat">
            <div class="work-visual" id="work-visual-cat">
              <a class="work-image-link" href={links.sc} aria-label={lang === 'ja' ? 'SwingCatのプロダクトページ' : 'SwingCat product page'}>
                <img class="work-ogp" src={images.sc} alt="SwingCat" width="1025" height="500" loading="lazy" decoding="async" />
                <div class="work-drawing">
              <svg viewBox="0 0 480 320" aria-hidden="true">
                <g class="drawing-ink">
                  <path d="M87 274q147-7 300 0M135 274l3-152m-16 12q-28 9-35-15-26-9-16-33-13-32 18-44 15-30 39-15 29-17 47 10 35 1 32 28 23 22-1 43-2 30-34 25m-24 141-1-187m0 52 24-26m-32 49-27-23m37-19q56 17 126-8"/>
                  <path d="m199 118 54-5 41-11"/>
                  <g class="swinging-cat"><path d="M263 107v85m38-90-7 91"/><path fill="#fff" d="m238 230 4-49 22 17q18-8 32-2l23-20 3 57q16 20 0 28-13 7-61 0-26 0-23-31Z"/><path fill="#000" d="m242 183 5 28 17-13Z"/><path d="m256 222 8 3m25-2 9-4m-24 10 3 4 4-5m-4 5q-6 10-12 2m12-2q7 8 13-1m-50 0-15-2m16 7-17 5m92-10 16-5m-17 12 19 3M320 256q40 7 40-14 0-17-13-13"/></g>
                  <path d="m192 272 5-10 7 10m177 0 5-14 7 14"/>
                  <path d="m356 131 12-2-10 16 12-2m14-29 17-2-13 22 17-2" stroke-width="3"/>
                </g>
              </svg>
            </div>
              </a>
            </div>
            <a class="work-caption" href={links.sc}><div><h3>SwingCat<span class="work-dot" aria-hidden="true">.</span></h3><p>{copy.cat}</p>{lang === 'ja' && <span class="work-kind">猫と暮らす、フォーカスタイマー</span>}</div><span class="drawn-arrow" aria-hidden="true">↗</span></a>
          </article>
          <article class="work work-radar">
            <div class="work-visual" id="work-visual-radar">
              <a class="work-image-link" href={links.sr} aria-label={lang === 'ja' ? 'Stealth Radarのプロダクトページ' : 'Stealth Radar product page'}>
                <img class="work-ogp" src={images.sr} alt="Stealth Radar" width="1200" height="630" loading="lazy" decoding="async" />
                <div class="work-drawing">
              <svg viewBox="0 0 480 320" aria-hidden="true">
                <g class="drawing-ink">
                  <path d="M75 265q124-7 164 0m49 0h115"/>
