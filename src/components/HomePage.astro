              <svg viewBox="0 0 480 320" aria-hidden="true">
                <g class="drawing-ink">
                  <path d="M82 269q174-5 317 0"/>
                  <g class="rolling-clock"><path fill="#fff" d="M336 180q0 83-76 84-80 0-81-78t76-84q77 0 81 78Z"/><path d="M258 117v16m61 50h-14m-47 63v-14m-61-48h15m46-33v36l-28 13"/><circle cx="258" cy="186" r="5" fill="#000"/><path d="m220 135 6 10m69-9-7 9m9 78-8-9m-68 8 8-10"/></g>
                  <g transform="translate(128 263) rotate(10) scale(2.4)" stroke-width="1.8">
                    <path d="M-4-7-10 0h-3m17-7 5 7h4m-20-16-7 3"/>
                    <path fill="#f5dc61" d="M-8-18q-1-12 8-12 10 0 9 13T0-7q-8 0-8-11Z"/>
                    <path d="M0-29q-6-9 2-12m-1 6q9-9 12-2-6 5-12 2"/>
                    <path stroke-width="1.5" d="m2-22 0 2m5-2v2"/>
                    <path d="m8-16 16-7"/>
                  </g>
                  <path d="m356 128 16-8m-23-10 8-14m5 47 19 1m-281 80H79m13 13H66"/>
                  <path d="m228 59 9 9 20-24m26 13 7 7 15-17"/>
                </g>
              </svg>
            </div>
              </a>
            </div>
            <a class="work-caption" href={links.ct}><div><h3>ClockTimer<span class="work-dot" aria-hidden="true">.</span></h3><p>{lang === 'ja' ? '今日の一歩を、じぶんのペースで。' : t(lang, 'product.ct.desc')}</p>{lang === 'ja' && <span class="work-kind">時間・習慣・やることを、ひとつに</span>}</div><span class="drawn-arrow" aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>

      <section class="about section-wrap" id="about" aria-labelledby="about-title">
        <svg class="about-doodle" viewBox="0 0 160 130" aria-hidden="true"><g class="drawing-ink"><path d="M22 96q46-7 116 0"/><path fill="#fff" d="m44 92-6-45 22-18 19 17 20-23 23 19-10 50Z"/><path d="m60 29 8 61m11-44 6 46m14-69 1 66m-53-42 10-8m-9 19 11-8m31-8 7-7m-4 19 7-7"/><path d="M77 17 74 5m17 10 7-12m10 18 12-5"/></g></svg>
        <h2 id="about-title">{copy.intro[0]}<br />{copy.intro[1]}</h2>
        <p>{copy.about[0]}<br />{copy.about[1]}</p>
        <p>{copy.values[0]}<br />{lang === 'ja' ? <>どちらも大切にしながら、<br class="mobile-break" />SynCraftはプロダクトをつくっています。</> : copy.values[1]}</p>
        <span class="about-signature" aria-hidden="true">Small tech. Real smiles.</span>
      </section>

      <section class="journal section-wrap" id="notes" aria-labelledby="journal-title">
        <div class="journal-heading"><div><h2 id="journal-title" class="outline-title">NOTES</h2><p class="section-subtitle">{copy.notes}</p></div><a href={getBlogIndexPath(lang)}>{copy.allNotes} <span aria-hidden="true">↗</span></a></div>
        {posts.map(post => {
          const slug = post.id.replace(`${lang}/`, '').replace(/\.mdx?$/, '');
          return <a class="journal-entry" href={getBlogPostPath(lang, slug)}>
            <time datetime={post.data.date.toISOString().slice(0,10)}>{post.data.date.toISOString().slice(0,10).replace(/-/g,'.')}</time>
            <h3>{lang === 'ja' ? (shortTitles[slug] ?? post.data.title) : post.data.title}</h3><span aria-hidden="true">↗</span>
          </a>;
        })}
      </section>

      <section class="contact section-wrap" id="contact" aria-labelledby="contact-title">
        <div class="contact-heading"><h2 id="contact-title" class="outline-title">CONTACT</h2><p class="section-subtitle">{copy.contact}</p></div>
        <div class="contact-copy"><p>{copy.contactCopy}</p><a class="email-link" href="mailto:hello@syncraft.dev">hello@syncraft.dev <span aria-hidden="true">↗</span></a></div>
        <svg class="contact-drawing" viewBox="0 0 340 280" aria-hidden="true"><g class="drawing-ink"><path d="M43 247q117-5 261 0M218 245v-105m15 105V140"/><path fill="#fff" d="M188 145V87q0-37 35-37 39-1 39 38v55Z"/><path d="m188 91 74-1m-55 24h38m-53-44 66-2m-21-13 1-18 26 2v15h-26"/><g transform="translate(123 230)"><path fill="#fff" d="M-26-32q-1-42 23-45 28-3 29 41T0 0q-25-1-26-32Z"/><path fill="#000" d="M-32-68q29-21 61-1Zm12-8q0-18 18-18 16 0 19 18"/><path d="m6-49 0 5m11-5v5m-32 16-19 15M-8 0l-9 17h-10M10 0l12 15h10m-2-50 31-42"/><path fill="#fff" d="m35-97 44 5-4 31-44-5Zm0 0 20 21 24-16"/></g><path d="m74 114-8-12m18 6 1-16m177 145 4-11 8 12"/></g></svg>
      </section>

<script is:inline type="module" src="/brand/story.js?v=20260922-1"></script>
</BaseLayout>
