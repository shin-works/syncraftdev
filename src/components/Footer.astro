---
import { languages, type Lang } from '../i18n/translations';
import { getLocalizedPath } from '../i18n/utils';
import { storyCopy } from '../i18n/story';
interface Props { lang: Lang; currentPath: string; alternateUrls?: Record<string, string>; preview?: boolean; }
const { lang, alternateUrls = {}, preview = false } = Astro.props;
const home = preview ? '/preview/' : getLocalizedPath('/', lang);
const choices = Object.entries(alternateUrls).filter(([code]) => code in languages);
---
<footer class="site-footer">
  <a class="footer-brand" href={home} aria-label={storyCopy[lang].home}>
    <img src="/syncraft_logo_yoko_new.png" alt="SynCraft" width="866" height="288" />
  </a>
  <span>© {new Date().getFullYear()} SynCraft</span>
  <a class="legal-link" href="/legal/">{storyCopy[lang].legal}</a>
  {choices.length > 1 && <details class="language-picker">
    <summary aria-label={lang === 'ja' ? '表示言語を選ぶ' : 'Choose language'}>{languages[lang]} <span aria-hidden="true">⌄</span></summary>
    <ul>{choices.map(([code, href]) => <li><a href={href} lang={code} hreflang={code} aria-current={code === lang ? 'page' : undefined}>{languages[code as Lang]}</a></li>)}</ul>
  </details>}
  {preview && <span class="preview-note">リニューアル試作</span>}
</footer>
