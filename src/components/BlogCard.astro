---
/**
 * BlogCard — Single article card for the blog list
 */
import type { Lang } from '../i18n/translations';
import { getBlogPostPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  date: Date;
  description: string;
  slug: string;
  image?: string;
  imageAlt?: string;
}

const { lang, title, date, description, slug, image, imageAlt } = Astro.props;

const href = getBlogPostPath(lang, slug);

const formattedDate = date.toISOString().slice(0, 10).replace(/-/g, '.');
const isoDate = date.toISOString().slice(0, 10);
---
<article class="note-entry">
  <time datetime={isoDate}>{formattedDate}</time>
  <a class="note-link" href={href}>
    <div><h2>{title}</h2><p>{description}</p></div>
    <span aria-hidden="true">↗</span>
  </a>
</article>
