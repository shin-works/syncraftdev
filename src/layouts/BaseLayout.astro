---
/**
 * BaseLayout — Shared paper-and-ink shell, SEO, loading indicator, and navigation
 */
import type { Lang } from '../i18n/translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';

import '../styles/storybook.css';
import '../styles/editorial.css';
import { storyCopy } from '../i18n/story';

interface Props {
  preview?: boolean;
  title: string;
  description: string;
  lang: Lang;
  canonicalUrl: string;
  alternateUrls?: Record<string, string>;
  activeNav?: string;
  currentPath: string;
  ogType?: string;
  ogImage?: string;
  article?: {
    headline: string;
    datePublished: string;
    dateModified?: string;
    description: string;
    url: string;
  };
}

const {
  preview = false,
  title,
  description,
  lang,
  canonicalUrl,
  alternateUrls,
  activeNav,
  currentPath,
  ogType,
  ogImage,
  article,
} = Astro.props;

const copy = storyCopy[lang];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {preview && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preload" href="/brand/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/brand/fonts/josefin-sans-latin.ttf" as="font" type="font/ttf" crossorigin />
  <SEOHead title={title} description={description} canonicalUrl={canonicalUrl} lang={lang}
    alternateUrls={alternateUrls} ogType={ogType} ogImage={ogImage} article={article} />
  <script is:inline>document.documentElement.dataset.loading = 'true';</script>
</head>
<body>
  <a class="skip-link" href="#main">{copy.skip}</a>
  <div class="page-loader" aria-hidden="true">
    <svg viewBox="0 0 160 90" fill="none" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path class="loader-line" pathLength="1" d="M10 70 Q50 68 80 70 T150 70" />
      <g class="loader-resident" transform="translate(80 69)">
        <path class="loader-legs" d="M-4-7-9 0h-3m16-7 5 7h4" />
        <path fill="#f5dc61" d="M-8-18q-1-12 8-12 10 0 9 13T0-7q-8 0-8-11Z" />
        <path d="M0-29q-6-9 2-12m-1 6q9-9 12-2-6 5-12 2m-19 19-6 5m21-5 6-5m-12-1v2m5-2v2" />
      </g>
    </svg>
    <span>{copy.loading}</span>
  </div>
  <Header lang={lang} currentPath={currentPath} alternateUrls={alternateUrls} activeNav={activeNav} />
  <main id="main"><slot /></main>
  <Footer lang={lang} currentPath={currentPath} alternateUrls={alternateUrls} preview={preview} />
  <script>
    // Reveal as soon as typography is ready; a CSS fallback also prevents blocking.
    Promise.race([document.fonts.ready, new Promise(resolve => setTimeout(resolve, 800))])
      .finally(() => delete document.documentElement.dataset.loading);
    window.addEventListener('pageshow', () => delete document.documentElement.dataset.loading);
  </script>
</body>
</html>
